<UserControl x:Class="MyLauncher.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#E0E0E0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 版本分组列表 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>

                <Expander Header="正式版" IsExpanded="True" Margin="0,0,0,8">
                    <ListBox x:Name="ReleaseList" Height="180"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="VersionList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Padding="4,6" Foreground="#E0E0E0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>

                <Expander Header="预览版" Margin="0,0,0,8">
                    <ListBox x:Name="SnapshotList" Height="180"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="VersionList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Padding="4,6" Foreground="#E0E0E0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>

                <Expander Header="远古版" Margin="0,0,0,8">
                    <ListBox x:Name="OldAlphaList" Height="180"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="VersionList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Padding="4,6" Foreground="#E0E0E0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="刷新列表" Width="80" Height="30" Margin="0,0,8,0"
                    Click="RefreshRemote_Click"/>
            <Button x:Name="InstallBtn" Content="下载并安装"
                    Width="120" Height="30" Click="Install_Click"/>
        </StackPanel>

        <!-- 进度条 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <ProgressBar x:Name="DownloadProgress" Height="20"/>
            <TextBlock x:Name="StatusText" Text="就绪" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 日志 -->
        <TextBox Grid.Row="3" x:Name="LogBox"
                 IsReadOnly="True" AcceptsReturn="True"
                 Height="120" VerticalScrollBarVisibility="Auto"
                 Background="#40000000" Foreground="#C0C0D0"
                 BorderThickness="0" Padding="8"
                 FontFamily="Consolas" FontSize="12"/>
    </Grid>
</UserControl>